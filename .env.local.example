# QuizWhiz local environment example.
# Copy to .env.local and adjust as needed.

# --- Firebase project config (dummy values are fine for local emulators) ---
NEXT_PUBLIC_FIREBASE_PROJECT_ID=demo-quizwhiz
NEXT_PUBLIC_FIREBASE_API_KEY=demo-local-key
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=localhost
NEXT_PUBLIC_FIREBASE_APP_ID=demo-app-id
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=demo-quizwhiz.appspot.com
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=demo-sender-id
NEXT_PUBLIC_FIREBASE_MEASUREMENT_ID=G-DEMOLOCAL

# --- Local Firebase Emulator Suite (opt-in) ---
# 1) Install https://firebase.tools and run: firebase emulators:start
# 2) Auth emulator listens on 127.0.0.1:9099, Firestore on 127.0.0.1:8087.
# 3) Seed demo data (host user + quizzes + a finished game) with:
#       npm run seed:demo
NEXT_PUBLIC_USE_FIREBASE_EMULATORS=1
